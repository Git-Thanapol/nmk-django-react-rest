# ─── Database ────────────────────────────────────────────────────────────────
# DB_HOST must be "db" — the name of the postgres service in docker-compose.yml
DB_NAME=nmk_db
DB_USER=nmk_user
DB_PASSWORD=changeme_strong_password
DB_HOST=db
DB_PORT=5432

# ─── Django ──────────────────────────────────────────────────────────────────
# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme_generate_a_real_secret_key

DEBUG=False

# Your VPS public IP address (no spaces, no http/https prefix)
ALLOWED_HOSTS=your.server.ip

# Must include the https:// prefix
CSRF_TRUSTED_ORIGINS=https://your.server.ip

# ─── Security (must be True when DEBUG=False + HTTPS) ────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ─── Admin superuser ─────────────────────────────────────────────────────────
# Created automatically on first deploy via entrypoint.sh
ADMIN_DJANGO_USERNAME=admin
ADMIN_DJANGO_PASSWORD=changeme_admin_password

# ─── Optional ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Gunicorn ────────────────────────────────────────────────────────────────
# (2 × vCPU) + 1  →  7 for a 3-core VPS
WEB_CONCURRENCY=7
